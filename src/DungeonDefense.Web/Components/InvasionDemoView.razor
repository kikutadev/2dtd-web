@implements IAsyncDisposable
@using DungeonDefense.Core
@using DungeonDefense.Presentation
@using System.Diagnostics
@inject HttpClient Http

@if (_demo is null)
{
    <div class="loading-shell"><p>@T("loading")</p></div>
}
else
{
    <div class="app-shell invasion-shell">
        <header class="topbar">
            <div>
                <h1>@T("title")</h1>
            </div>
            <div class="top-actions">
                @if (_demo.Simulation is null)
                {
                    <button class="mode-link" @onclick="NavigateBack">← @PreparationBackLabel</button>
                }
                <div class="locale-picker">
                    <button class="@(_locale == WebDemoLocalization.Japanese ? "active" : null)" @onclick="() => SetLocale(WebDemoLocalization.Japanese)">日本語</button>
                    <button class="@(_locale == WebDemoLocalization.English ? "active" : null)" @onclick="() => SetLocale(WebDemoLocalization.English)">EN</button>
                </div>
            </div>
        </header>

        <section class="status-row">
            <div><span>@T("location")</span><strong>@LocationName(_demo.SelectedLocation.Id)</strong></div>
            <div><span>@T("objective")</span><strong>@ObjectiveName(_demo.SelectedFloor.Objective.Kind)</strong></div>
            <div><span>@T("sections")</span><strong>@SectionStatus</strong></div>
            <div><span>@T("capacity")</span><strong>@_demo.UsedDeploymentCapacity / @_demo.DeploymentCapacity</strong></div>
            <div><span>@T("status")</span><strong>@OutcomeText</strong></div>
        </section>

        @if (_demo.Simulation is null)
        {
            <main class="game-layout invasion-layout">
                <section class="world-card invasion-briefing">
                    @if (_preBattleStage == InvasionPreparationStage.Locations)
                    {
                        var locations = _demo.LocationsState;
                        <div class="world-heading"><div><strong>@T("locations")</strong><span>@T("locations_desc")</span></div></div>
                        <div class="invasion-selection-list">
                            @foreach (var location in locations.Locations)
                            {
                                <article class="invasion-selection-card">
                                    <div>
                                        <strong>@LocationName(location.LocationId)</strong>
                                        <span>@T("available_floors") @location.AvailableFloorCount / @location.FloorCount</span>
                                    </div>
                                    <div class="selection-progress">@T("unlocked") @location.UnlockedFloorCount / @location.FloorCount</div>
                                    <button class="primary" @onclick="() => SelectLocation(location.LocationId)">@T("inspect")</button>
                                </article>
                            }
                        </div>
                    }
                    else if (_preBattleStage == InvasionPreparationStage.Scout)
                    {
                        var scout = _demo.ScoutState;
                        <div class="world-heading"><div><strong>@LocationName(scout.LocationId)</strong><span>@T("scout_desc")</span></div></div>
                        <div class="invasion-selection-list scout-list">
                            @foreach (var floor in scout.Floors)
                            {
                                <article class="invasion-selection-card scout-card @(floor.IsUnlocked && floor.IsAvailable ? null : "disabled")">
                                    <div class="scout-card-main">
                                        <strong>@FloorName(floor.Depth) · @ObjectiveName(floor.Objective)</strong>
                                        <span>@T("sections") @floor.SectionCount · @string.Join(" · ", floor.ThreatTags.Select(ThreatName))</span>
                                        <small>@T("visible_loot"): @ResourceText(floor.VisibleSectionLoot)</small>
                                        <small>@T("clear_reward"): @ResourceText(floor.ClearReward)</small>
                                    </div>
                                    <InvasionDungeonMap Scout="floor.Map" Compact="true" />
                                    <div class="selection-progress">@(floor.IsFirstClear ? T("first_clear") : T("repeat"))</div>
                                    <button class="primary" disabled="@(!floor.IsUnlocked || !floor.IsAvailable)" @onclick="() => SelectFloor(floor.FloorId)">@T("form_party")</button>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        var formation = _demo.FormationState;
                        <div class="world-heading"><div><strong>@T("formation")</strong><span>@LocationName(formation.LocationId) · @FloorName(formation.Depth) · @ObjectiveName(formation.Objective)</span></div></div>
                        <div class="formation-target-summary">
                            <div class="threat-block">
                                <div class="section-label">@T("threats")</div>
                                <div class="threat-tags">
                                    @foreach (var tag in _demo.SelectedScoutReport.ThreatTags) { <span>@ThreatName(tag)</span> }
                                </div>
                            </div>
                            <div class="scout-rewards">
                                <div><span>@T("visible_loot")</span><strong>@ResourceText(_demo.SelectedScoutReport.VisibleSectionLoot)</strong></div>
                                <div><span>@T("clear_reward")</span><strong>@ResourceText(_demo.SelectedScoutReport.ClearReward)</strong></div>
                            </div>
                            <p class="muted">@T("formation_hint")</p>
                        </div>
                    }
                </section>

                <aside class="control-card invasion-formation">
                    @if (_preBattleStage == InvasionPreparationStage.Locations)
                    {
                        <div class="section-label">@T("objective")</div>
                        <p class="muted">@T("locations_side_hint")</p>
                    }
                    else if (_preBattleStage == InvasionPreparationStage.Scout)
                    {
                        <div class="section-label">@T("scouting")</div>
                        <p class="muted">@T("scout_side_hint")</p>
                    }
                    else
                    {
                        var formation = _demo.FormationState;
                        <div class="section-label">@T("formation")</div>
                        @foreach (var unit in formation.Units)
                        {
                            <div class="formation-unit">
                                <img src="@AssetUrl(unit.Asset)" alt="@UnitName(unit.DefinitionId)" />
                                <div><strong>@UnitName(unit.DefinitionId)</strong><small>@RoleName(unit.DefinitionId) · @unit.DeploymentCost cap</small></div>
                                <div class="count-stepper">
                                    <button @onclick="() => AdjustFormation(unit.DefinitionId, -1)" disabled="@(unit.Count == 0)">−</button>
                                    <span>@unit.Count</span>
                                    <button @onclick="() => AdjustFormation(unit.DefinitionId, 1)" disabled="@(!CanAdd(unit.DefinitionId))">＋</button>
                                </div>
                            </div>
                        }
                        <div class="capacity-meter"><span style="width:@CapacityPercent%"></span></div>
                        <div class="capacity-text">@formation.UsedCapacity / @formation.Capacity</div>
                        <button class="primary invasion-start" @onclick="StartInvasion" disabled="@(!formation.CanStart)">@T("start")</button>
                        @if (!string.IsNullOrWhiteSpace(_notice)) { <p class="notice">@_notice</p> }
                    }
                </aside>
            </main>
        }
        else if (_demo.ResultState is { } result)
        {
            <main class="game-layout invasion-layout">
                <section class="world-card invasion-result-screen">
                    <div class="world-heading"><div><strong>@T("result")</strong><span>@LocationName(result.LocationId) · @FloorName(result.FloorDepth) · @ObjectiveName(result.Objective)</span></div></div>
                    <div class="invasion-result-body @OutcomeClass">
                        <div class="result-outcome invasion-result-outcome">
                            <span>@T("result")</span>
                            <h2>@OutcomeText</h2>
                            <p>@T(result.LessonMessageKey)</p>
                        </div>
                        <div class="result-impact-grid invasion-result-stats">
                            <span>@T("force")</span><strong>@result.Survivors / @result.TotalUnits</strong>
                            <span>@T("defeated")</span><strong>@result.DefeatedCount</strong>
                            <span>@T("progress")</span><strong>@result.ReachedSection / @result.SectionCount</strong>
                            <span>@T("secured")</span><strong>@ResourceText(result.SecuredLoot)</strong>
                        </div>
                        <div class="result-floor-strip">
                            @for (var index = 0; index < result.SectionCount; index++)
                            {
                                var reached = index < result.ReachedSection;
                                <div class="result-floor @(reached ? "held" : null)">
                                    <span>@SectionLabel(index)</span>
                                    <strong>@(reached ? T("section_reached") : T("section_unreached"))</strong>
                                </div>
                            }
                        </div>
                    </div>
                </section>
                <aside class="control-card invasion-controls">
                    <div class="control-group result-actions">
                        <div class="section-label">@T("result_next")</div>
                        <button class="primary" @onclick="ReturnToBriefing">@T("again")</button>
                    </div>
                    <p class="muted result-action-hint">@T("result_hint")</p>
                </aside>
            </main>
        }
        else
        {
            var battle = _demo.VisualState!;
            <main class="game-layout invasion-layout">
                <section class="world-card invasion-battle">
                    <div class="world-heading">
                        <div><strong>@T("battle")</strong><span>@LocationName(_demo.SelectedLocation.Id) · @FloorName(_demo.SelectedFloor)</span></div>
                        <div class="speed-picker" aria-label="speed">
                            @foreach (var speed in new[] { 1, 2, 3 })
                            {
                                <button class="@(speed == _speed ? "active" : null)" @onclick="() => _speed = speed">@speed×</button>
                            }
                        </div>
                    </div>
                    <div class="invasion-battle-body">
                        <div class="section-track battle-track" aria-label="invasion checkpoints">
                            @foreach (var section in battle.Sections)
                            {
                                <div class="invasion-section @(section.Cleared ? "cleared" : section.Current ? "current" : "upcoming")">
                                    <span>@SectionLabel(section.Index)</span>
                                    <strong>@(section.Cleared ? T("section_reached") : section.Current ? T("running") : T("section_unreached"))</strong>
                                </div>
                            }
                        </div>

                        <div class="battle-staging-strip" data-testid="invasion-reserve">
                            <div class="staging-copy">
                                <span>@T("reserve") <strong>@battle.ReserveUnits.Length</strong></span>
                                <span>@T("staging") <strong>@battle.StagedUnits.Length</strong></span>
                                <span>@T("active") <strong>@battle.ActiveUnits.Length</strong></span>
                                <span>@T("enemy") <strong>@battle.EnemyGuards.Count(x => x.Alive)</strong></span>
                            </div>
                            <div class="staging-units">
                                @foreach (var unit in battle.ReserveUnits.Take(6))
                                {
                                    <img src="@AssetUrl(unit.Asset)" alt="@UnitName(unit.DefinitionId)" title="@UnitName(unit.DefinitionId)" />
                                }
                                @foreach (var unit in battle.StagedUnits.Take(Math.Max(0, 6 - battle.ReserveUnits.Length)))
                                {
                                    <img class="staged" src="@AssetUrl(unit.Asset)" alt="@UnitName(unit.DefinitionId)" title="@UnitName(unit.DefinitionId)" />
                                }
                            </div>
                        </div>

                        <InvasionDungeonMap Battle="battle" Combat="_demo.CombatVisualState" />
                        <div class="battle-latest-event">@LatestEventText(battle.LatestEvent)</div>
                    </div>
                </section>

                <aside class="control-card invasion-controls">
                    @if (battle.Outcome == InvasionOutcome.Running)
                    {
                        <div class="control-group invasion-primary deploy-commands">
                            @foreach (var command in battle.DeployCommands)
                            {
                                <button class="primary" @onclick="() => DeployOne(command.UnitDefinitionId)" disabled="@(!command.Enabled)">
                                    @UnitName(command.UnitDefinitionId) +1 (@command.ReserveCount)
                                </button>
                            }
                            <button @onclick="ToggleRun">@(_running ? T("pause") : T("resume"))</button>
                        </div>
                        <div class="control-group invasion-summary">
                            <div class="analysis-grid">
                                <span>@T("active")</span><strong>@battle.ActiveUnits.Length</strong>
                                <span>@T("reserve")</span><strong>@battle.ReserveUnits.Length</strong>
                                <span>@T("defeated")</span><strong>@battle.DefeatedCount</strong>
                                <span>MP</span><strong>@battle.Mp / @battle.MaxMp</strong>
                            </div>
                        </div>
                        <div class="control-group">
                            <div class="section-label">@T("support")</div>
                            <button @onclick="CastMend" disabled="@(!battle.Mend.Enabled)">@T("mend")</button>
                            <button @onclick="CastWard" disabled="@(!battle.Ward.Enabled)">@T("ward")</button>
                            <button class="danger" @onclick="RequestRetreat" disabled="@(!battle.Retreat.Enabled)">@RetreatText(battle)</button>
                            @if (!string.IsNullOrWhiteSpace(_notice)) { <p class="notice">@_notice</p> }
                        </div>
                    }
                </aside>
            </main>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public DefenseContent DefenseContent { get; set; } = null!;
    [Parameter] public EventCallback OnBack { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private PeriodicTimer? _timer;
    private InvasionDemo? _demo;
    private bool _running;
    private int _speed = 1;
    private string _locale = WebDemoLocalization.Japanese;
    private string? _notice;
    private InvasionPreparationStage _preBattleStage = InvasionPreparationStage.Locations;

    protected override async Task OnInitializedAsync()
    {
        var content = await WebInvasionContentLoader.LoadAsync(Http, DefenseContent, _cts.Token);
        _demo = new InvasionDemo(DefenseContent, content);
        _ = RunLoopAsync(_cts.Token);
    }

    private async Task RunLoopAsync(CancellationToken cancellationToken)
    {
        _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(16));
        var previousTimestamp = Stopwatch.GetTimestamp();
        try
        {
            while (await _timer.WaitForNextTickAsync(cancellationToken))
            {
                var now = Stopwatch.GetTimestamp();
                var delta = Stopwatch.GetElapsedTime(previousTimestamp, now).TotalSeconds;
                previousTimestamp = now;
                if (_demo is null) continue;
                var changed = _demo.AdvanceFrame(delta, _speed, _running);
                if (_running && _demo.Simulation?.Outcome != InvasionOutcome.Running) _running = false;
                if (changed) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private async Task NavigateBack()
    {
        _running = false;
        if (_preBattleStage == InvasionPreparationStage.Formation) { _preBattleStage = InvasionPreparationStage.Scout; return; }
        if (_preBattleStage == InvasionPreparationStage.Scout) { _preBattleStage = InvasionPreparationStage.Locations; return; }
        await OnBack.InvokeAsync();
    }
    private string PreparationBackLabel => _preBattleStage switch
    {
        InvasionPreparationStage.Formation => T("scouting"),
        InvasionPreparationStage.Scout => T("locations"),
        _ => T("back"),
    };
    private void SetLocale(string locale) { _locale = locale; _notice = null; }
    private void SelectLocation(string id) { _demo!.SelectLocation(id); _preBattleStage = InvasionPreparationStage.Scout; _notice = null; }
    private void SelectFloor(string id) { _demo!.SelectFloor(id); _preBattleStage = InvasionPreparationStage.Formation; _notice = null; }
    private void AdjustFormation(string unitId, int delta) { if (!_demo!.AdjustFormation(unitId, delta)) _notice = $"Capacity {_demo.DeploymentCapacity}"; else _notice = null; }
    private bool CanAdd(string unitId) => _demo is not null && _demo.UsedDeploymentCapacity + _demo.Content.UnitDeploymentCosts[unitId] <= _demo.DeploymentCapacity;

    private void StartInvasion()
    {
        _demo!.Start(seed: 4242);
        _running = true;
        _notice = null;
    }
    private void DeployOne(string unitId) { _demo!.Deploy(unitId); _running = true; _notice = null; }
    private void ToggleRun() => _running = !_running;
    private void CastMend() => CastSpell("invasion.spell.mend");
    private void CastWard() => CastSpell("invasion.spell.ward");
    private void CastSpell(string spellId) { _notice = _demo!.CastSupportSpell(spellId) ? null : "MP / Cooldown"; }
    private void RequestRetreat() { _demo!.RequestRetreat(); _notice = null; }
    private void ReturnToBriefing() { _demo!.ReturnToBriefing(); _running = false; _preBattleStage = InvasionPreparationStage.Scout; _notice = null; }

    private int CapacityPercent => _demo is null ? 0 : Math.Clamp(_demo.UsedDeploymentCapacity * 100 / _demo.DeploymentCapacity, 0, 100);
    private string SectionStatus => _demo?.VisualState is { } state
        ? $"{state.CurrentSectionIndex + 1}/{state.Sections.Length}"
        : $"{_demo?.SelectedFloor.Sections.Count ?? 0}";
    private string OutcomeText => _demo?.Simulation?.Outcome switch
    {
        InvasionOutcome.Success => T("success"), InvasionOutcome.Wiped => T("wiped"), InvasionOutcome.Retreated => T("retreated"),
        InvasionOutcome.Running => T("running"), _ => T("ready"),
    };
    private string OutcomeClass => _demo?.Simulation?.Outcome switch { InvasionOutcome.Success => "success", InvasionOutcome.Wiped => "failure", InvasionOutcome.Retreated => "retreated", _ => "" };
    private string T(string key) => WebInvasionLocalization.Text(_locale, key);
    private string LocationName(string id) => WebInvasionLocalization.LocationName(_locale, id);
    private string ThreatName(string tag) => WebInvasionLocalization.ThreatName(_locale, tag);
    private string ObjectiveName(InvasionObjectiveKind objective) => WebInvasionLocalization.ObjectiveName(_locale, objective);
    private string FloorName(InvasionFloorDefinition floor) => FloorName(floor.Depth);
    private string FloorName(int depth) => _locale == WebDemoLocalization.Japanese ? $"地下{depth}階" : $"B{depth}F";
    private string SectionLabel(int index) => _locale == WebDemoLocalization.Japanese ? $"区画 {index + 1}" : $"Section {index + 1}";
    private string UnitName(string id) => WebDemoLocalization.BuildName(_locale, id);
    private string RoleName(string id) => _demo is null ? "" : _demo.Content.UnitRoleProfile(id).Archetype switch
    {
        InvasionUnitArchetype.Vanguard => _locale == WebDemoLocalization.Japanese ? "前衛" : "Vanguard",
        InvasionUnitArchetype.BacklineStriker => _locale == WebDemoLocalization.Japanese ? "後衛火力" : "Backline Striker",
        _ => _demo.Content.UnitRoleProfile(id).Archetype.ToString(),
    };
    private static string UnitAsset(string id) => WebProductAssets.Unit(id);
    private static string AssetUrl(ProductAssetRef? asset)
        => asset is { } value ? WebProductAssets.Resolve(value) : WebProductAssets.Unit("monster.skeleton_warrior");
    private string LatestEventText(ProductMessage? message)
    {
        if (message is null) return T("events_empty");
        var unit = string.IsNullOrWhiteSpace(message.SubjectDefinitionId) ? string.Empty : UnitName(message.SubjectDefinitionId);
        return message.Key switch
        {
            "invasion.event.deployed" => _locale == WebDemoLocalization.Japanese ? $"{unit}を投入" : $"Deployed {unit}",
            "invasion.event.attack" => _locale == WebDemoLocalization.Japanese ? $"{unit}が敵へ{message.Amount}ダメージ" : $"{unit} dealt {message.Amount} damage",
            "invasion.event.damaged" => _locale == WebDemoLocalization.Japanese ? $"{unit}が{message.Amount}ダメージ" : $"{unit} took {message.Amount} damage",
            "invasion.event.defeated" => _locale == WebDemoLocalization.Japanese ? $"{unit}が戦闘不能" : $"{unit} was defeated",
            "invasion.event.enemy_defeated" => _locale == WebDemoLocalization.Japanese ? $"{unit}を撃破" : $"Defeated {unit}",
            "invasion.event.heal" => _locale == WebDemoLocalization.Japanese ? $"{unit}を{message.Amount}回復" : $"Healed {unit} for {message.Amount}",
            "invasion.event.ward" => _locale == WebDemoLocalization.Japanese ? $"進軍部隊に防護 +{message.Amount}" : $"Ward +{message.Amount} to the active force",
            "invasion.event.section_cleared" => T("section_cleared"),
            "invasion.event.retreating" => T("retreat_requested"),
            "invasion.event.objective_damaged" => _locale == WebDemoLocalization.Japanese ? $"Objectiveへ{message.Amount}ダメージ" : $"Objective took {message.Amount} damage",
            "invasion.event.objective_completed" => T("objective_complete"),
            _ => message.Key,
        };
    }
    private string RetreatText(InvasionBattleVisualState state)
        => state.Retreat.CountdownSeconds is { } seconds
            ? (_locale == WebDemoLocalization.Japanese ? $"撤退中 {seconds:0.0}s" : $"Retreating {seconds:0.0}s")
            : T("retreat");
    private string ResourceText(ResourceBundle value)
        => _locale == WebDemoLocalization.Japanese
            ? $"石 {value.Stone} · 鉄 {value.Iron} · 魂 {value.Soul} · 遺物 {value.Relic}"
            : $"Stone {value.Stone} · Iron {value.Iron} · Soul {value.Soul} · Relic {value.Relic}";


    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _timer?.Dispose();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }
}
