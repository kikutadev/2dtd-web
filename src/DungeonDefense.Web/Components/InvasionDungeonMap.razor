@using DungeonDefense.Application
@using DungeonDefense.Core
@using DungeonDefense.Presentation

<div class="invasion-dungeon-map @(Compact ? "compact" : "battle")" data-map-digest="@MapDigest" aria-label="enemy dungeon map">
    <svg viewBox="0 0 @Width @Height" role="img" aria-label="Enemy dungeon battlefield" preserveAspectRatio="xMidYMid meet">
        <rect class="map-backdrop" x="0" y="0" width="@Width" height="@Height" />

        @foreach (var tile in Tiles)
        {
            if (tile.Kind == TileKind.Bedrock)
            {
                <rect class="tile bedrock" x="@tile.Position.X" y="@tile.Position.Y" width="1" height="1" />
            }
            else
            {
                <image class="tile @TileClass(tile.Kind)" href="@WebProductAssets.Resolve(tile.Asset)"
                       x="@tile.Position.X" y="@tile.Position.Y" width="1" height="1" preserveAspectRatio="xMidYMid slice" />
            }
        }

        @foreach (var room in Rooms)
        {
            <rect class="room-footprint" data-room="@room.InstanceId"
                  x="@room.Origin.X" y="@room.Origin.Y" width="@room.Width" height="@room.Height" />
            @foreach (var wall in WallSegments(room))
            {
                <line class="room-wall" x1="@F(wall.X1)" y1="@F(wall.Y1)" x2="@F(wall.X2)" y2="@F(wall.Y2)" />
            }
        }

        @if (Route.Count > 1)
        {
            <polyline class="objective-route" data-testid="invasion-route" points="@RoutePoints(Route)" />
        }

        @if (Battle is not null)
        {
            @foreach (var section in Battle.Sections)
            {
                if (section.Current)
                {
                    @foreach (var cell in section.Cells)
                    {
                        <rect class="current-section-cell" x="@F(cell.X + 0.08)" y="@F(cell.Y + 0.08)" width=".84" height=".84" />
                    }
                }
                <rect class="checkpoint @(section.Cleared ? "cleared" : section.Current ? "current" : "upcoming")"
                      x="@F(section.Checkpoint.X + 0.18)" y="@F(section.Checkpoint.Y + 0.18)" width=".64" height=".64" />
            }
        }
        else if (Scout is not null)
        {
            @foreach (var section in Scout.Sections)
            {
                <rect class="checkpoint scout" x="@F(section.Checkpoint.X + 0.18)" y="@F(section.Checkpoint.Y + 0.18)" width=".64" height=".64" />
            }
        }

        @if (Scout is not null)
        {
            @foreach (var actor in Scout.VisibleActors)
            {
                if (actor.Asset is { } asset)
                {
                    <image class="map-actor scout-actor @ScoutActorClass(actor.Kind)" data-actor="@actor.InstanceId"
                           href="@WebProductAssets.Resolve(asset)" x="@F(actor.Position.X + .08)" y="@F(actor.Position.Y + .08)"
                           width=".84" height=".84" preserveAspectRatio="xMidYMid meet" />
                }
            }
            @DrawObjective(Scout.Objective.Kind, Scout.Objective.Position, null, 0, 0, false)
        }

        @if (Battle is not null)
        {
            @foreach (var actor in Battle.StaticActors)
            {
                if (actor.Asset is { } asset)
                {
                    <image class="map-actor static-actor @StaticActorClass(actor.Kind)" data-actor="@actor.InstanceId"
                           href="@WebProductAssets.Resolve(asset)" x="@F(actor.Position.X + .06)" y="@F(actor.Position.Y + .06)"
                           width=".88" height=".88" preserveAspectRatio="xMidYMid meet" />
                }
            }

            @DrawObjective(Battle.Objective.Kind, Battle.Objective.Position, Battle.Objective.Asset, Battle.Objective.CurrentHp, Battle.Objective.MaxHp, Battle.Objective.Completed)

            @foreach (var unit in Combat.Units)
            {
                var unitAsset = ProductAssetIdentity.Unit(unit.DefinitionId, unit.Facing);
                <g class="combat-unit @(unit.Team == Team.Dungeon ? "attacker" : "enemy") @(unit.Lifecycle == CombatVisualLifecycle.Dying ? "dying" : null)"
                   data-unit="@unit.EntityId" transform="translate(@F(unit.RenderPosition.X + .5) @F(unit.RenderPosition.Y + .5)) scale(@F(unit.ScaleX) @F(unit.ScaleY))">
                    @if (unitAsset is { } asset)
                    {
                        <image href="@WebProductAssets.Resolve(asset)" x="-.5" y="-.5" width="1" height="1" opacity="@F(unit.Opacity)" preserveAspectRatio="xMidYMid meet" />
                    }
                    @if (unit.ShowHp && unit.MaxHp > 0)
                    {
                        <rect class="unit-hp-bg" x="-.38" y="-.51" width=".76" height=".07" />
                        <rect class="unit-hp-fill @(unit.Team == Team.Dungeon ? "attacker" : "enemy")" x="-.38" y="-.51"
                              width="@F(.76 * Math.Clamp(unit.Hp / (double)unit.MaxHp, 0, 1))" height=".07" />
                    }
                    @if (unit.HitFlashStrength > 0)
                    {
                        <rect class="hit-flash" x="-.4" y="-.4" width=".8" height=".8" opacity="@F(unit.HitFlashStrength * .45)" />
                    }
                </g>
            }

            @foreach (var projectile in Combat.Projectiles)
            {
                var py = projectile.Position.Y + .5 - projectile.ProjectileHeight * .7;
                <line class="projectile-trail" x1="@F(projectile.From.X + .5)" y1="@F(projectile.From.Y + .5)"
                      x2="@F(projectile.Position.X + .5)" y2="@F(py)" />
                <circle class="projectile" cx="@F(projectile.Position.X + .5)" cy="@F(py)" r=".07" />
            }
        }
    </svg>
</div>

@code {
    [Parameter] public InvasionBattleVisualState? Battle { get; set; }
    [Parameter] public InvasionScoutMapVisualState? Scout { get; set; }
    [Parameter] public CombatVisualState Combat { get; set; } = CombatVisualState.Empty;
    [Parameter] public bool Compact { get; set; }

    private int Width => Battle?.BoardWidth ?? Scout?.Width ?? 1;
    private int Height => Battle?.BoardHeight ?? Scout?.Height ?? 1;
    private string MapDigest => Scout?.MapDigest ?? string.Empty;
    private IReadOnlyList<InvasionTileVisualState> Tiles => Battle?.Tiles ?? (IReadOnlyList<InvasionTileVisualState>?)Scout?.Tiles ?? [];
    private IReadOnlyList<InvasionRoomVisualState> Rooms => Battle?.Rooms ?? (IReadOnlyList<InvasionRoomVisualState>?)Scout?.Rooms ?? [];
    private IReadOnlyList<GridPoint> Route => Battle?.Route ?? (IReadOnlyList<GridPoint>?)Scout?.ObjectiveRoute ?? [];

    private static string F(double value) => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    private static string TileClass(TileKind kind) => kind.ToString().ToLowerInvariant();
    private static string ScoutActorClass(InvasionScoutActorKind kind) => kind.ToString().ToLowerInvariant();
    private static string StaticActorClass(InvasionActorKind kind) => kind.ToString().ToLowerInvariant();
    private static string RoutePoints(IEnumerable<GridPoint> points)
        => string.Join(" ", points.Select(point => $"{F(point.X + .5)},{F(point.Y + .5)}"));

    private static IEnumerable<WallSegment> WallSegments(InvasionRoomVisualState room)
    {
        var openings = room.Connections.Select(x => (x.LocalCell, x.Direction)).ToHashSet();
        for (var y = 0; y < room.Height; y++)
        for (var x = 0; x < room.Width; x++)
        {
            var local = new GridPoint(x, y);
            var left = room.Origin.X + x;
            var top = room.Origin.Y + y;
            if (y == 0 && !openings.Contains((local, CardinalDirection.North))) yield return new(left, top, left + 1, top);
            if (x == room.Width - 1 && !openings.Contains((local, CardinalDirection.East))) yield return new(left + 1, top, left + 1, top + 1);
            if (y == room.Height - 1 && !openings.Contains((local, CardinalDirection.South))) yield return new(left, top + 1, left + 1, top + 1);
            if (x == 0 && !openings.Contains((local, CardinalDirection.West))) yield return new(left, top, left, top + 1);
        }
    }

    private RenderFragment DrawObjective(
        InvasionObjectiveKind kind,
        GridPoint position,
        ProductAssetRef? asset,
        int currentHp,
        int maxHp,
        bool completed) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "g");
        builder.AddAttribute(sequence++, "class", $"map-objective {kind.ToString().ToLowerInvariant()} {(completed ? "completed" : string.Empty)}");
        builder.AddAttribute(sequence++, "data-testid", "invasion-objective");
        if (asset is { } value)
        {
            builder.OpenElement(sequence++, "image");
            builder.AddAttribute(sequence++, "href", WebProductAssets.Resolve(value));
            builder.AddAttribute(sequence++, "x", F(position.X - .2));
            builder.AddAttribute(sequence++, "y", F(position.Y + .08));
            builder.AddAttribute(sequence++, "width", "1.4");
            builder.AddAttribute(sequence++, "height", ".84");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(sequence++, "polygon");
            builder.AddAttribute(sequence++, "points", $"{F(position.X + .5)},{F(position.Y + .2)} {F(position.X + .8)},{F(position.Y + .5)} {F(position.X + .5)},{F(position.Y + .8)} {F(position.X + .2)},{F(position.Y + .5)}");
            builder.CloseElement();
        }
        if (maxHp > 0 && !completed)
        {
            var ratio = Math.Clamp(currentHp / (double)maxHp, 0, 1);
            builder.OpenElement(sequence++, "rect");
            builder.AddAttribute(sequence++, "class", "objective-hp-bg");
            builder.AddAttribute(sequence++, "x", F(position.X + .08));
            builder.AddAttribute(sequence++, "y", F(position.Y - .02));
            builder.AddAttribute(sequence++, "width", ".84");
            builder.AddAttribute(sequence++, "height", ".08");
            builder.CloseElement();
            builder.OpenElement(sequence++, "rect");
            builder.AddAttribute(sequence++, "class", "objective-hp-fill");
            builder.AddAttribute(sequence++, "x", F(position.X + .08));
            builder.AddAttribute(sequence++, "y", F(position.Y - .02));
            builder.AddAttribute(sequence++, "width", F(.84 * ratio));
            builder.AddAttribute(sequence++, "height", ".08");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private readonly record struct WallSegment(double X1, double Y1, double X2, double Y2);
}
