    private string UnitStyle(CombatUnitVisualState unit)
    {
        var visual = unit.RenderPosition;
        var width = 100.0 / Board.Width;
        var height = 100.0 / Board.Height;
        var left = visual.X * width;
        var top = visual.Y * height;
        var brightness = 1.0 + (unit.HitFlashStrength * 0.65);
        return FormattableString.Invariant($"left:{left:0.###}%;top:{top:0.###}%;width:{width:0.###}%;height:{height:0.###}%;opacity:{unit.Opacity:0.###};transform:scale({unit.ScaleX:0.###},{unit.ScaleY:0.###});filter:brightness({brightness:0.###});");
    }

    private string ProjectileStyle(CombatProjectileVisualState projectile)
    {
        var point = projectile.Position;
        var left = ((point.X + 0.5) * 100.0) / Board.Width;
        var top = ((point.Y + 0.5 - projectile.ProjectileHeight) * 100.0) / Board.Height;
        return FormattableString.Invariant($"left:{left:0.###}%;top:{top:0.###}%;");
    }

    private string ProjectileGroundStyle(CombatProjectileVisualState projectile)
    {
        var point = projectile.Position;
        var left = ((point.X + 0.5) * 100.0) / Board.Width;
        var top = ((point.Y + 0.5) * 100.0) / Board.Height;
        return FormattableString.Invariant($"left:{left:0.###}%;top:{top:0.###}%;");
    }

