@page "/"
@implements IAsyncDisposable
@using DungeonDefense.Application
@using DungeonDefense.Core
@using DungeonDefense.Presentation
@using System.Diagnostics
@inject HttpClient Http

<PageTitle>Dungeon Defense</PageTitle>

@if (_build is null)
{
    <div class="loading-shell"><div class="loader"></div><p>@T("loading")</p></div>
}
else
{
    @if (_showInvasion && _content is not null)
    {
        <InvasionDemoView DefenseContent="_content" OnBack="CloseInvasionDemo" />
    }
    else
    {
    <div class="app-shell">
        <header class="topbar">
            <div>
                <h1>@T("title")</h1>
            </div>
            <div class="top-actions"><button class="mode-link" @onclick="OpenInvasionDemo">@T("invasion_demo")</button><div class="locale-picker"><button class="@(_locale == WebDemoLocalization.Japanese ? "active" : null)" @onclick="() => SetLocale(WebDemoLocalization.Japanese)">日本語</button><button class="@(_locale == WebDemoLocalization.English ? "active" : null)" @onclick="() => SetLocale(WebDemoLocalization.English)">EN</button></div></div>
        </header>

        @if (IsBuilding)
        {
            <section class="status-row">
                <div><span>@T("phase")</span><strong>@T("build_phase")</strong></div>
                <div><span>@T("capacity")</span><strong>@BuildState.UsedCapacity / @BuildState.CapacityMax</strong></div>
                <div><span>@T("route")</span><strong>@BuildState.RouteLength cells</strong></div>
                <div><span>@T("defense")</span><strong>@(BuildState.CanStartDefense ? T("ready") : T("needs_fix"))</strong></div>
                <div><span>@T("placements")</span><strong>@BuildState.PlacementCount</strong></div>
            </section>
        }
        else
        {
            <section class="status-row">
                <div><span>@T("defense")</span><strong>@OutcomeText</strong></div>
                <div><span>@T("wave")</span><strong>@WaveText</strong></div>
                <div><span>@T("core")</span><strong>@CoreText</strong></div>
                <div><span>MP</span><strong>@MpText</strong></div>
                <div><span>@T("impact")</span><strong>@DesignImpactText</strong></div>
            </section>
        }

        <main class="game-layout">
            <section class="world-card">
                @if (DefenseResult is { } result)
                {
                    <div class="world-heading result-heading">
                        <div><strong>@T("result")</strong><span>@T("result_heading")</span></div>
                    </div>
                    <section class="defense-result-screen @(result.Outcome == DefenseOutcome.Success ? "success" : "failure")">
                        <div class="result-world-state">
                            <img class="result-core-large" src="@WebProductAssets.Resolve(result.CoreAsset)" alt="Core" />
                            <div class="result-outcome">
                                <span>@T("result")</span>
                                <h2>@OutcomeText</h2>
                                <p>@T(result.HypothesisMessageKey)</p>
                            </div>
                        </div>
                        <div class="result-impact-grid result-impact-large">
                            <span>@T("result_core")</span><strong>@result.CoreHp / @result.CoreMaxHp</strong>
                            <span>@T("result_trap")</span><strong>@result.TrapDamage</strong>
                            <span>@T("result_guard")</span><strong>@result.GuardDamage</strong>
                            <span>@T("result_facility")</span><strong>@result.FacilityDamage</strong>
                            <span>@T("result_core_hits")</span><strong>@result.CoreHitCount</strong>
                            <span>@T("result_spells")</span><strong>@result.SpellCasts</strong>
                        </div>
                        <div class="result-floor-strip">
                            @foreach (var floor in result.Floors)
                            {
                                <div class="result-floor @(floor.Breached ? "breached" : "held")">
                                    <span>B@floor.Depth</span>
                                    <strong>@(floor.Breached ? T("result_breached") : T("result_held"))</strong>
                                    <small>@T("result_pressure") @floor.TrafficCount · @T("result_damage") @(floor.TrapDamage + floor.GuardDamage + floor.FacilityDamage)</small>
                                </div>
                            }
                        </div>
                    </section>
                }
                else
                {
                    <div class="world-heading">
                        <div>
                            <strong>@T("floor_1")</strong>
                            <span>@(IsBuilding ? T("build_heading") : T("battle_heading"))</span>
                        </div>
                        @if (!IsBuilding)
                        {
                            <div class="speed-picker" aria-label="再生速度">
                                @foreach (var speed in new[] { 1, 2, 3 })
                                {
                                    <button class="@(speed == _speed ? "active" : null)" @onclick="() => _speed = speed">@speed×</button>
                                }
                            </div>
                        }
                    </div>

                    <div class="board-wrap">
                        <div class="board @(IsBuilding ? "build-board" : null)" style="grid-template-columns: repeat(@Board.Width, 1fr);">
                            @for (var y = 0; y < Board.Height; y++)
                            {
                                @for (var x = 0; x < Board.Width; x++)
                                {
                                    var point = new GridPoint(x, y);
                                    <button type="button"
                                            class="cell @BuildCellClass(point)"
                                            disabled="@(!IsBuilding)"
                                            aria-label="@CellAriaLabel(point)"
                                            @onclick="() => HandleCellClick(point)"
                                            style="background-image:url('@TileAsset(point, Board)')">
                                        @if (point == Board.Core)
                                        {
                                            <img class="object core" src="@CoreAsset" alt="Core" />
                                        }
                                        @foreach (var trap in Board.Traps.Where(t => t.Position == point))
                                        {
                                            <img class="object fixture" src="@TrapAsset(trap.DefinitionId)" alt="@BuildOptionText(trap.DefinitionId)" />
                                        }
                                        @foreach (var facility in Board.Facilities.Where(f => f.Position == point))
                                        {
                                            <img class="object fixture" src="@FacilityAsset(facility.DefinitionId)" alt="@BuildOptionText(facility.DefinitionId)" />
                                        }
                                        @if (IsBuilding)
                                        {
                                            @foreach (var guard in Board.Guards.Where(g => g.Position == point))
                                            {
                                                <img class="unit" src="@UnitAsset(guard.DefinitionId, "E")" alt="@BuildOptionText(guard.DefinitionId)" />
                                            }
                                        }
                                    </button>
                                }
                            }
                            @if (_demo?.Simulation is not null)
                            {
                                <div class="unit-layer" aria-hidden="true">
                                    @foreach (var unit in _demo.VisualState.Units)
                                    {
                                        <div class="unit-wrap @TeamClass(unit.Team)" style="@UnitStyle(unit)">
                                            <img class="unit" src="@UnitAsset(unit.DefinitionId, CombatMotionPresentation.FacingSuffix(unit.Facing))" alt="@unit.DefinitionId" />
                                            @if (unit.ShowHp)
                                            {
                                                <div class="hp"><span style="width:@HpPercent(unit)%"></span></div>
                                            }
                                        </div>
                                    }
                                    <svg class="beam-layer" viewBox="0 0 @Board.Width @Board.Height" preserveAspectRatio="none">
                                        @foreach (var beam in _demo.VisualState.Projectiles.Where(x => x.Trajectory == ProjectileTrajectoryKind.Beam))
                                        {
                                            <line x1="@(beam.From.X + 0.5f)" y1="@(beam.From.Y + 0.5f)"
                                                  x2="@(beam.To.X + 0.5f)" y2="@(beam.To.Y + 0.5f)"
                                                  vector-effect="non-scaling-stroke" />
                                        }
                                    </svg>
                                    @foreach (var projectile in _demo.VisualState.Projectiles.Where(x => x.Trajectory != ProjectileTrajectoryKind.Beam))
                                    {
                                        @if (projectile.ProjectileHeight > 0.01f)
                                        {
                                            <span class="projectile-shadow" style="@ProjectileGroundStyle(projectile)"></span>
                                        }
                                        <span class="projectile" style="@ProjectileStyle(projectile)"></span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @if (IsBuilding)
                    {
                        <div class="build-hint">
                            @if (_removeMode)
                            {
                                <span>@T("remove_hint")</span>
                            }
                            else
                            {
                                <span>@((MarkupString)F("place_hint", $"<strong>{System.Net.WebUtility.HtmlEncode(SelectedBuildLabel)}</strong>"))</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="timeline"><span style="width:@ProgressPercent%"></span></div>
                    }
                }
            </section>

            <aside class="control-card">
                @if (IsBuilding)
                {
                    <div class="control-group build-controls">
                        <div class="section-label">@T("place_section")</div>
                        <div class="build-option-list">
                            @foreach (var option in _build.BuildOptions)
                            {
                                <button class="build-option @BuildOptionClass(option)" @onclick="() => SelectBuildOption(option)">
                                    <span>@BuildOptionText(option.Id)</span>
                                    <small>@BuildKindText(option.Kind) · @option.CapacityCost</small>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="control-group build-tools">
                        <div class="section-label">@T("edit_section")</div>
                        @if (SelectedBuildOption?.Kind == BuildKind.Room)
                        {
                            <button class="@(_rotated ? "active-tool" : null)" @onclick="ToggleRotation">@T("rotate_room")</button>
                        }
                        <button class="@(_removeMode ? "danger active-tool" : null)" @onclick="ToggleRemoveMode">@T("remove")</button>
                        <button @onclick="ResetBuild">@T("reset_board")</button>
                    </div>

                    <div class="control-group build-analysis">
                        <div class="section-label">@T("summary")</div>
                        <div class="analysis-grid">
                            <span>@T("first_contact")</span><strong>@FirstContactText</strong>
                            <span>@T("trap_contacts")</span><strong>@BuildState.TrapContactCount</strong>
                            <span>@T("guard_coverage")</span><strong>@BuildState.GuardCoveredRouteCells / @BuildState.RouteLength</strong>
                            <span>@T("facility_coverage")</span><strong>@BuildState.FacilityCoveredRouteCells / @BuildState.RouteLength</strong>
                        </div>
                    </div>

                    <div class="control-group start-defense">
                        <button class="primary" disabled="@(!_build.StartValidation.Success)" @onclick="StartBuiltDefense">@T("start_defense")</button>
                        @if (!_build.StartValidation.Success)
                        {
                            <p class="notice">@string.Join(" / ", _build.StartValidation.Errors)</p>
                        }
                        else if (!string.IsNullOrWhiteSpace(_notice))
                        {
                            <p class="notice">@_notice</p>
                        }
                    </div>
                }
                else if (DefenseResult is not null)
                {
                    <div class="control-group result-actions">
                        <div class="section-label">@T("result_next")</div>
                        <button class="primary" @onclick="ReturnToBuild">@T("return_build")</button>
                        <button @onclick="ToggleRun">@T("run_again")</button>
                    </div>
                    <p class="muted result-action-hint">@T("result_action_hint")</p>
                }
                else
                {
                    <div class="control-group primary-controls">
                        <button class="primary" @onclick="ToggleRun">@RunButtonText</button>
                    </div>

                    <div class="control-group">
                        <div class="section-label">@T("magic")</div>
                        <button @onclick="CastFreeze" disabled="@(!SpellEnabled("spell.freeze"))">@SpellButtonText("spell.freeze", "freeze")</button>
                        <button @onclick="CastPush" disabled="@(!SpellEnabled("spell.push"))">@SpellButtonText("spell.push", "push")</button>
                        @if (!string.IsNullOrWhiteSpace(_notice)) { <p class="notice">@_notice</p> }
                    </div>

                    <div class="control-group event-log">
                        <div class="section-label">@T("recent_events")</div>
                        <p class="muted">@LatestDefenseEventText</p>
                    </div>
                }
            </aside>
        </main>

    </div>
    }
}

@code {
    private readonly CancellationTokenSource _cts = new();
    private PeriodicTimer? _timer;
    private DefenseContent? _content;
    private DungeonBuildDemo? _build;
    private DefenseDemo? _demo;
    private bool _running;
    private int _speed = 1;
    private string? _selectedDefinitionId;
    private bool _removeMode;
    private bool _rotated;
    private string? _notice;
    private bool _showInvasion;
    private string _locale = WebDemoLocalization.Japanese;

    private bool IsBuilding => _demo is null;
    private DefenseHudVisualState? DefenseHud => _demo?.HudState;
    private DefenseResultVisualState? DefenseResult => _demo?.ResultState;
    private DungeonState Board => _demo?.Board ?? _build!.Board;
    private DungeonBuildVisualState BuildState => _build!.ProductState;
    private BuildOption? SelectedBuildOption => _build?.BuildOptions.SingleOrDefault(x => x.Id == _selectedDefinitionId);
    private string SelectedBuildLabel => SelectedBuildOption is null ? "配置物" : BuildOptionText(SelectedBuildOption.Id);
    private string FirstContactText => BuildState.FirstDefenseContactPathIndex < 0 ? T("none") : $"route {BuildState.FirstDefenseContactPathIndex}";

    protected override async Task OnInitializedAsync()
    {
        _content = await WebDefenseContentLoader.LoadAsync(Http, _cts.Token);
        _build = new DungeonBuildDemo(_content);
        _selectedDefinitionId = DefenseSliceBuildCatalog.SpikeTrap.Id;
        _ = RunLoopAsync(_cts.Token);
    }

    private async Task RunLoopAsync(CancellationToken cancellationToken)
    {
        _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(16));
        var previousTimestamp = Stopwatch.GetTimestamp();
        try
        {
            while (await _timer.WaitForNextTickAsync(cancellationToken))
            {
                var nowTimestamp = Stopwatch.GetTimestamp();
                var deltaSeconds = Stopwatch.GetElapsedTime(previousTimestamp, nowTimestamp).TotalSeconds;
                previousTimestamp = nowTimestamp;
                if (_demo is null) continue;
                var changed = _demo.AdvanceFrame(deltaSeconds, _speed, _running);
                if (_running && _demo.Simulation?.Outcome != DefenseOutcome.Running) _running = false;
                if (changed) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void OpenInvasionDemo()
    {
        _running = false;
        _showInvasion = true;
    }

    private void CloseInvasionDemo()
    {
        _showInvasion = false;
        _notice = null;
    }

    private void SetLocale(string locale)
    {
        _locale = locale == WebDemoLocalization.English ? WebDemoLocalization.English : WebDemoLocalization.Japanese;
        _notice = null;
    }

    private void SelectBuildOption(BuildOption option)
    {
        _selectedDefinitionId = option.Id;
        _removeMode = false;
        _rotated = false;
        _notice = null;
    }

    private void ToggleRotation()
    {
        if (SelectedBuildOption?.Kind == BuildKind.Room) _rotated = !_rotated;
    }

    private void ToggleRemoveMode()
    {
        _removeMode = !_removeMode;
        _notice = null;
    }

    private void HandleCellClick(GridPoint point)
    {
        if (_build is null || !IsBuilding) return;
        if (_removeMode)
        {
            RemoveAt(point);
            return;
        }
        if (_selectedDefinitionId is null) return;

        var result = _build.Place(_selectedDefinitionId, point.X, point.Y, _rotated);
        _notice = result.Success ? F("placed", SelectedBuildLabel) : result.Error;
    }

    private void RemoveAt(GridPoint point)
    {
        if (_build is null) return;
        var guard = Board.Guards.FirstOrDefault(x => x.Position == point);
        if (guard is not null) { SetRemoveNotice(_build.Remove(BuildKind.Guard, guard.InstanceId), "Guard"); return; }
        var trap = Board.Traps.FirstOrDefault(x => x.Position == point);
        if (trap is not null) { SetRemoveNotice(_build.Remove(BuildKind.Trap, trap.InstanceId), "Trap"); return; }
        var facility = Board.Facilities.FirstOrDefault(x => x.Position == point);
        if (facility is not null) { SetRemoveNotice(_build.Remove(BuildKind.Facility, facility.InstanceId), "Facility"); return; }
        var room = Board.RoomAt(point);
        if (room is not null) { SetRemoveNotice(_build.Remove(BuildKind.Room, room.InstanceId), "Room"); return; }
        _notice = T("nothing_remove");
    }

    private void SetRemoveNotice(SemanticEditResult result, string label)
        => _notice = result.Success ? F("removed", label) : result.Error;

    private void ResetBuild()
    {
        _build?.Reset();
        _removeMode = false;
        _rotated = false;
        _notice = T("board_reset");
    }

    private void StartBuiltDefense()
    {
        if (_build is null || _content is null) return;
        var validation = _build.StartValidation;
        if (!validation.Success)
        {
            _notice = string.Join(" / ", validation.Errors);
            return;
        }

        _demo = new DefenseDemo(_content, _build.Session);
        _demo.Start();
        _running = true;
        _notice = null;
    }

    private void ReturnToBuild()
    {
        if (_build is null || _demo?.Simulation?.Outcome is not (DefenseOutcome.Success or DefenseOutcome.Failure)) return;
        _build.ReturnToBuild();
        _demo = null;
        _running = false;
        _notice = T("returned_build");
    }

    private void ToggleRun()
    {
        if (_demo is null) return;
        if (_demo.Simulation is null || _demo.Simulation.Outcome != DefenseOutcome.Running)
        {
            _demo.Start();
            _running = true;
            _notice = null;
            return;
        }
        _running = !_running;
    }

    private void CastFreeze() { if (_demo is not null) _notice = _demo.CastFreeze(); }
    private void CastPush() { if (_demo is not null) _notice = _demo.CastPush(); }

    private string BuildCellClass(GridPoint point)
    {
        var classes = new List<string>(2);
        if (Board.IsIngress(point)) classes.Add("ingress");
        if (!IsBuilding || _build is null) return string.Join(' ', classes);
        if (_removeMode)
        {
            if (HasRemovable(point)) classes.Add("remove-target");
            return string.Join(' ', classes);
        }
        if (_selectedDefinitionId is null) return string.Join(' ', classes);
        classes.Add(_build.PreviewPlacement(_selectedDefinitionId, point.X, point.Y, _rotated).Success ? "build-valid" : "build-invalid");
        return string.Join(' ', classes);
    }

    private bool HasRemovable(GridPoint point)
        => Board.Guards.Any(x => x.Position == point)
           || Board.Traps.Any(x => x.Position == point)
           || Board.Facilities.Any(x => x.Position == point)
           || Board.RoomAt(point) is not null;

    private string CellAriaLabel(GridPoint point)
        => IsBuilding ? $"セル {point.X},{point.Y} {BuildCellClass(point)}" : $"戦闘セル {point.X},{point.Y}";

    private string BuildOptionClass(BuildOption option)
        => !_removeMode && option.Id == _selectedDefinitionId ? "selected" : string.Empty;

    private string RunButtonText => _demo?.Simulation switch
    {
        null => T("run_start"),
        { Outcome: DefenseOutcome.Running } when _running => T("run_pause"),
        { Outcome: DefenseOutcome.Running } => T("run_resume"),
        _ => T("run_again"),
    };
    private string OutcomeText => _demo?.Simulation?.Outcome switch { DefenseOutcome.Success => T("outcome_success"), DefenseOutcome.Failure => T("outcome_failure"), _ => _running ? T("outcome_running") : T("outcome_paused") };
    private string WaveText => DefenseHud is { } hud ? $"{hud.WaveNumber}/{hud.WaveCount}" : "0/0";
    private string CoreText => DefenseHud is { } hud ? $"{hud.CoreHp}/{hud.CoreMaxHp}" : "—";
    private string MpText => DefenseHud is { } hud ? $"{hud.Mp}/{hud.MaxMp}" : "—";
    private string DesignImpactText => DefenseHud is { } hud
        ? $"{hud.DesignImpact.TrapDamage}/{hud.DesignImpact.GuardDamage}/{hud.DesignImpact.FacilityDamage}"
        : "—";
    private bool SpellEnabled(string spellId)
        => DefenseHud?.Spells.FirstOrDefault(x => string.Equals(x.SpellId, spellId, StringComparison.Ordinal))?.Enabled == true;
    private string SpellButtonText(string spellId, string fallbackKey)
    {
        var spell = DefenseHud?.Spells.FirstOrDefault(x => string.Equals(x.SpellId, spellId, StringComparison.Ordinal));
        if (spell is null) return T(fallbackKey);
        var name = spellId == "spell.freeze" ? T("freeze_name") : spellId == "spell.push" ? T("push_name") : spellId;
        return spell.CooldownTicks > 0
            ? $"{name} {spell.MpCost} MP · {spell.CooldownTicks / (double)DefenseSimulation.TicksPerSecond:0.0}s"
            : $"{name} {spell.MpCost} MP";
    }
    private string LatestDefenseEventText => DefenseHud?.LatestEvent is { } message ? DefenseMessageText(message) : T("events_empty");
    private string DefenseMessageText(ProductMessage message) => message.Key switch
    {
        "combat.status.wave_start" => F("status_wave_start", message.Amount),
        "combat.status.wave_end" => F("status_wave_end", message.Amount),
        "combat.status.breached" => F("status_breached", message.Amount),
        "combat.status.floor_entered" => F("status_floor_entered", message.Amount),
        "combat.status.trap" => F("status_trap", message.Amount),
        "combat.status.core_hit" => F("status_core_hit", message.Amount),
        "combat.status.spell" => string.IsNullOrWhiteSpace(message.SubjectDefinitionId) ? T("event_spell") : message.SubjectDefinitionId,
        "combat.status.defeated" => string.IsNullOrWhiteSpace(message.SubjectDefinitionId) ? T("event_death") : F("status_defeated", BuildOptionText(message.SubjectDefinitionId)),
        _ => message.Key,
    };
    private int ProgressPercent => _demo?.Simulation is { } s ? Math.Min(100, s.Tick * 100 / 430) : 0;
    private string CoreAsset
        => WebProductAssets.Resolve(_demo?.ResultState?.CoreAsset ?? ProductAssetIdentity.Core(damaged: false));

    private static string TileAsset(GridPoint point, DungeonState board)
        => WebProductAssets.Resolve(ProductAssetIdentity.Tile(board.GetTile(point)));

    private static string TrapAsset(string id)
        => ProductAssetIdentity.Trap(id) is { } asset ? WebProductAssets.Resolve(asset) : string.Empty;

    private static string FacilityAsset(string id)
        => ProductAssetIdentity.Facility(id) is { } asset ? WebProductAssets.Resolve(asset) : string.Empty;

    private static string TeamClass(Team team) => team == Team.Invader ? "invader" : "dungeon";
    private static int HpPercent(CombatUnitVisualState unit) => unit.MaxHp <= 0 ? 0 : Math.Clamp(unit.Hp * 100 / unit.MaxHp, 0, 100);

    private string UnitStyle(CombatUnitVisualState unit)
    {
        var visual = unit.RenderPosition;
        var width = 100.0 / Board.Width;
        var height = 100.0 / Board.Height;
        var left = visual.X * width;
        var top = visual.Y * height;
        var brightness = 1.0 + (unit.HitFlashStrength * 0.65);
        return FormattableString.Invariant($"left:{left:0.###}%;top:{top:0.###}%;width:{width:0.###}%;height:{height:0.###}%;opacity:{unit.Opacity:0.###};transform:scale({unit.ScaleX:0.###},{unit.ScaleY:0.###});filter:brightness({brightness:0.###});");
    }

    private string ProjectileStyle(CombatProjectileVisualState projectile)
    {
        var point = projectile.Position;
        var left = ((point.X + 0.5) * 100.0) / Board.Width;
        var top = ((point.Y + 0.5 - projectile.ProjectileHeight) * 100.0) / Board.Height;
        return FormattableString.Invariant($"left:{left:0.###}%;top:{top:0.###}%;");
    }

    private string ProjectileGroundStyle(CombatProjectileVisualState projectile)
    {
        var point = projectile.Position;
        var left = ((point.X + 0.5) * 100.0) / Board.Width;
        var top = ((point.Y + 0.5) * 100.0) / Board.Height;
        return FormattableString.Invariant($"left:{left:0.###}%;top:{top:0.###}%;");
    }

    private static string UnitAsset(string definitionId, string facing)
        => WebProductAssets.Unit(definitionId, facing);

    private string BuildOptionText(string id) => WebDemoLocalization.BuildName(_locale, id);

    private string BuildKindText(BuildKind kind) => kind switch
    {
        BuildKind.Room => T("kind_room"),
        BuildKind.Trap => T("kind_trap"),
        BuildKind.Guard => T("kind_guard"),
        BuildKind.Facility => T("kind_facility"),
        _ => kind.ToString(),
    };


    private string T(string key) => WebDemoLocalization.Text(_locale, key);
    private string F(string key, params object[] args) => WebDemoLocalization.Format(_locale, key, args);

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _timer?.Dispose();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }
}
