@page "/"
@implements IAsyncDisposable
@using DungeonDefense.Application
@using DungeonDefense.Core
@using DungeonDefense.Presentation
@using DungeonDefense.Contracts
@using DungeonDefense.Infrastructure
@using Microsoft.JSInterop
@using System.Diagnostics
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Dungeon Defense</PageTitle>

@if (_content is null || _cosmetics is null)
{
    <div class="loading-shell"><div class="loader"></div><p>@T("loading")</p></div>
}
else if (_showShop && _cosmetics is not null)
{
    var shopState = CurrentShopState;
    var selectedShop = SelectedShopProduct;
    <main class="shop-shell">
        <header class="hub-top shop-top">
            <div><strong>@T("shop.heading")</strong><span>@T("shop.preview_only")</span></div>
            <div class="hub-top-actions"><button @onclick="CloseShop">@T("common.back")</button></div>
        </header>
        <section class="shop-body">
            <nav class="shop-catalog">
                <strong>@T("shop.theme_pack")</strong>
                @foreach (var product in shopState.Products)
                {
                    var productId = product.ProductId;
                    <button class="@(selectedShop?.ProductId == product.ProductId ? "active" : null)" @onclick="() => SelectShopProduct(productId)">
                        <span>@CosmeticProductName(product.ProductId)</span>
                        <small>@(product.Equipped ? T("shop.equipped") : product.Owned ? T("shop.owned") : T("shop.preview_only_short"))</small>
                    </button>
                }
            </nav>
            <section class="shop-detail">
                @if (selectedShop is not null)
                {
                    <div class="shop-copy">
                        <div><h1>@CosmeticProductName(selectedShop.ProductId)</h1><p>@CosmeticProductDescription(selectedShop.ProductId)</p></div>
                        @if (selectedShop.Equipped)
                        {
                            <button disabled>@T("shop.equipped")</button>
                        }
                        else
                        {
                            <button disabled title="@T("shop.web_purchase_unavailable")">@T("shop.web_purchase_unavailable")</button>
                        }
                    </div>
                    <div class="shop-preview-grid">
                        @foreach (var preview in ShopPreviewAssets(selectedShop))
                        {
                            <figure><img src="@preview.Path" alt="@preview.Label" /><figcaption>@preview.Label</figcaption></figure>
                        }
                    </div>
                    <p class="shop-note">@T("shop.no_gameplay_effect")</p>
                }
            </section>
        </section>
    </main>
}
else if (!_runStarted)
{
    <main class="title-screen">
        <div class="title-locale locale-picker">
            <button class="@(_locale == WebDemoLocalization.Japanese ? "active" : null)" @onclick="() => SetLocale(WebDemoLocalization.Japanese)">日本語</button>
            <button class="@(_locale == WebDemoLocalization.English ? "active" : null)" @onclick="() => SetLocale(WebDemoLocalization.English)">EN</button>
        </div>
        <section class="title-panel">
            <div class="title-mark">DUNGEON CORE</div>
            <h1>@T("start.title")</h1>
            <p class="title-description">@T("start.description")</p>
            <div class="title-spirit">
                <img src="@WebProductAssets.Resolve(ProductAssetIdentity.DarkSpiritPortrait(DarkSpiritExpression.Neutral))" alt="@T("spirit.speaker")" />
                <div>
                    <strong>◆ @T("spirit.speaker")</strong>
                    <p>@T("start.spirit")</p>
                </div>
            </div>
            <div class="title-actions">
                <button class="primary start-run" @onclick="StartNewRun">@T("start.new_run")</button>
                <button disabled="@(!_hasSavedRun)" @onclick="ContinueCurrentRun" title="@(_hasSavedRun ? T("start.continue_session") : T("start.continue_unavailable"))">@T("start.continue")</button>
                <button @onclick="OpenShopFromTitle">@T("shop.heading")</button>
            </div>
            <small class="title-save-note">@(_titleNotice ?? (_hasSavedRun ? T("start.continue_session") : T("start.continue_unavailable")))</small>
        </section>
    </main>
}
else if (_showHub && _build is not null)
{
    <main class="hub-shell">
        <header class="hub-top">
            <div><strong>@T("hub.heading")</strong><span>@T("hub.day1")</span></div>
            <div class="hub-top-actions"><button @onclick="ReturnToTitle">@T("common.title")</button><div class="locale-picker"><button class="@(_locale == WebDemoLocalization.Japanese ? "active" : null)" @onclick="() => SetLocale(WebDemoLocalization.Japanese)">日本語</button><button class="@(_locale == WebDemoLocalization.English ? "active" : null)" @onclick="() => SetLocale(WebDemoLocalization.English)">EN</button></div></div>
        </header>
        <section class="hub-body">
            <div class="hub-dungeon">
                <div class="hub-summary"><strong>@T("hub.current_dungeon")</strong><span>@F("hub.capacity_route", BuildState.UsedCapacity, BuildState.CapacityMax, BuildState.RouteLength)</span></div>
                <div class="hub-board board" style="grid-template-columns: repeat(@Board.Width, 1fr);">
                    @for (var y = 0; y < Board.Height; y++)
                    {
                        @for (var x = 0; x < Board.Width; x++)
                        {
                            var point = new GridPoint(x, y);
                            <div class="cell" style="background-image:url('@TileAsset(point, Board)')">
                                @if (point == Board.Core) { <img class="object core" src="@CoreAsset" alt="Core" /> }
                            </div>
                        }
                    }
                </div>
                <div class="hub-spirit">
                    <img src="@WebProductAssets.Resolve(ProductAssetIdentity.DarkSpiritPortrait(DarkSpiritExpression.Neutral))" alt="@T("spirit.speaker")" />
                    <div><strong>◆ @T("spirit.speaker")</strong><p>@T("hub.spirit_first")</p></div>
                </div>
            </div>
            <nav class="hub-actions">
                <button class="primary" @onclick="OpenBriefingFromHub">@T("hub.next_assault")</button>
                <button @onclick="OpenBuildFromHub">@T("hub.edit")</button>
                <div class="hub-secondary"><button @onclick="OpenInvasionFromHub">@T("hub.invasion")</button><button @onclick="OpenShopFromHub">@T("shop.heading")</button><button disabled>@T("hub.research")</button></div>
            </nav>
        </section>
    </main>
}
else if (_showBriefing && _build is not null)
{
    <main class="briefing-shell">
        <section class="briefing-panel">
            <div class="briefing-heading"><span>@T("briefing.label")</span><h1>@T("briefing.title")</h1></div>
            <div class="briefing-facts"><div><span>@T("route")</span><strong>@BuildState.RouteLength</strong></div><div><span>@T("placements")</span><strong>@BuildState.PlacementCount</strong></div><div><span>@T("defense")</span><strong>@(BuildState.CanStartDefense ? T("ready") : T("needs_fix"))</strong></div></div>
            <p>@T("briefing.description")</p>
            <div class="briefing-actions"><button @onclick="ReturnToHub">@T("common.home")</button><button @onclick="OpenBuildFromBriefing">@T("hub.edit")</button><button class="primary tutorial-defense-start" disabled="@(!_build.StartValidation.Success)" @onclick="StartDefenseFromBriefing">@T("briefing.defend")</button></div>
        </section>
        <TutorialSpiritOverlay Flow="_tutorial" Content="_narrativeContent!" Locale="@_locale" OnNext="TutorialNext" OnSkip="SkipTutorial" />
    </main>
}
else
{
    @if (_showInvasion && _content is not null)
    {
        <InvasionDemoView DefenseContent="_content" OnBack="CloseInvasionDemo" />
    }
    else
    {
    <div class="app-shell">
        @if (IsBuilding)
        {
            <header class="mobile-game-topbar">
                <button class="floor-chip">@T("floor_1")</button>
                <span>@T("capacity") <strong>@BuildState.UsedCapacity/@BuildState.CapacityMax</strong></span>
                <span>@T("route") <strong>@BuildState.RouteLength</strong></span>
                <span class="topbar-spacer"></span>
                <button @onclick="OpenBriefingFromEditor">@T("hub.next_assault")</button>
                <button class="primary tutorial-editor-done" @onclick="OpenBriefingFromEditor">@T("editor.done")</button>
            </header>
        }
        else
        {
            <header class="mobile-game-topbar combat-topbar">
                <span><strong>@T("hub.day1")</strong></span>
                <span>@T("wave") <strong>@WaveText</strong></span>
                <span class="topbar-spacer"></span>
                <span>@T("core") <strong>@CoreText</strong></span>
            </header>
        }

        <main class="game-layout @(IsBuilding ? "mobile-build-layout" : DefenseResult is not null ? "mobile-result-layout" : "mobile-combat-layout")">
            <section class="world-card">
                @if (DefenseResult is { } result)
                {
                    <div class="world-heading result-heading">
                        <div><strong>@T("result")</strong><span>@T("result_heading")</span></div>
                    </div>
                    <section class="defense-result-screen @(result.Outcome == DefenseOutcome.Success ? "success" : "failure")">
                        <div class="result-world-state">
                            <img class="result-core-large" src="@WebProductAssets.Resolve(result.CoreAsset)" alt="Core" />
                            <div class="result-outcome">
                                <span>@T("result")</span>
                                <h2>@OutcomeText</h2>
                                <p>@T(result.HypothesisMessageKey)</p>
                            </div>
                        </div>
                        @{ var spiritHint = DarkSpiritHintPresentation.BuildDefenseHint(result); }
                        <div class="spirit-message" data-spirit-beat="@spiritHint.BeatId">
                            <img class="spirit-portrait" src="@WebProductAssets.Resolve(spiritHint.SpeakerPortrait)" alt="@T("spirit.speaker")" />
                            <div class="spirit-copy">
                                <strong>◆ @T("spirit.speaker")</strong>
                                <span>@T(spiritHint.MessageKey)</span>
                            </div>
                        </div>
                        <div class="result-impact-grid result-impact-large">
                            <span>@T("result_core")</span><strong>@result.CoreHp / @result.CoreMaxHp</strong>
                            <span>@T("result_trap")</span><strong>@result.TrapDamage</strong>
                            <span>@T("result_guard")</span><strong>@result.GuardDamage</strong>
                            <span>@T("result_facility")</span><strong>@result.FacilityDamage</strong>
                            <span>@T("result_core_hits")</span><strong>@result.CoreHitCount</strong>
                            <span>@T("result_spells")</span><strong>@result.SpellCasts</strong>
                        </div>
                        <div class="result-floor-strip">
                            @foreach (var floor in result.Floors)
                            {
                                <div class="result-floor @(floor.Breached ? "breached" : "held")">
                                    <span>B@floor.Depth</span>
                                    <strong>@(floor.Breached ? T("result_breached") : T("result_held"))</strong>
                                    <small>@T("result_pressure") @floor.TrafficCount · @T("result_damage") @(floor.TrapDamage + floor.GuardDamage + floor.FacilityDamage)</small>
                                </div>
                            }
                        </div>
                    </section>
                }
                else
                {
                    <div class="world-heading">
                        <div>
                            <strong>@T("floor_1")</strong>
                            <span>@(IsBuilding ? T("build_heading") : T("battle_heading"))</span>
                        </div>

                    </div>

                    <div class="board-wrap">
                        <div class="board @(IsBuilding ? "build-board" : null)" style="grid-template-columns: repeat(@Board.Width, 1fr);">
                            @for (var y = 0; y < Board.Height; y++)
                            {
                                @for (var x = 0; x < Board.Width; x++)
                                {
                                    var point = new GridPoint(x, y);
                                    <button type="button"
                                            class="cell @BuildCellClass(point)"
                                            disabled="@(!IsBuilding)"
                                            aria-label="@CellAriaLabel(point)"
                                            @onclick="() => HandleCellClick(point)"
                                            style="background-image:url('@TileAsset(point, Board)')">
                                        @if (point == Board.Core)
                                        {
                                            <img class="object core" src="@CoreAsset" alt="Core" />
                                        }
                                        @foreach (var trap in Board.Traps.Where(t => t.Position == point))
                                        {
                                            <img class="object fixture" src="@TrapAsset(trap.DefinitionId)" alt="@BuildOptionText(trap.DefinitionId)" />
                                        }
                                        @foreach (var facility in Board.Facilities.Where(f => f.Position == point))
                                        {
                                            <img class="object fixture" src="@FacilityAsset(facility.DefinitionId)" alt="@BuildOptionText(facility.DefinitionId)" />
                                        }
                                        @if (IsBuilding)
                                        {
                                            @foreach (var guard in Board.Guards.Where(g => g.Position == point))
                                            {
                                                <img class="unit" src="@UnitAsset(guard.DefinitionId, "E")" alt="@BuildOptionText(guard.DefinitionId)" />
                                            }
                                        }
                                    </button>
                                }
                            }
                            @if (_demo?.Simulation is not null)
                            {
                                <div class="unit-layer" aria-hidden="true">
                                    @foreach (var unit in _demo.VisualState.Units)
                                    {
                                        <div class="unit-wrap @TeamClass(unit.Team)" style="@UnitStyle(unit)">
                                            <img class="unit" src="@UnitAsset(unit.DefinitionId, CombatMotionPresentation.FacingSuffix(unit.Facing))" alt="@unit.DefinitionId" />
                                            @if (unit.ShowHp)
                                            {
                                                <div class="hp"><span style="width:@HpPercent(unit)%"></span></div>
                                            }
                                        </div>
                                    }
                                    <svg class="beam-layer" viewBox="0 0 @Board.Width @Board.Height" preserveAspectRatio="none">
                                        @foreach (var beam in _demo.VisualState.Projectiles.Where(x => x.Trajectory == ProjectileTrajectoryKind.Beam))
                                        {
                                            <line x1="@(beam.From.X + 0.5f)" y1="@(beam.From.Y + 0.5f)"
                                                  x2="@(beam.To.X + 0.5f)" y2="@(beam.To.Y + 0.5f)"
                                                  vector-effect="non-scaling-stroke" />
                                        }
                                    </svg>
                                    @foreach (var projectile in _demo.VisualState.Projectiles.Where(x => x.Trajectory != ProjectileTrajectoryKind.Beam))
                                    {
                                        @if (projectile.ProjectileHeight > 0.01f)
                                        {
                                            <span class="projectile-shadow" style="@ProjectileGroundStyle(projectile)"></span>
                                        }
                                        <span class="projectile" style="@ProjectileStyle(projectile)"></span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @if (IsBuilding)
                    {
                        <div class="build-hint">
                            @if (_removeMode)
                            {
                                <span>@T("remove_hint")</span>
                            }
                            else
                            {
                                <span>@BuildInteractionHint</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="timeline"><span style="width:@ProgressPercent%"></span></div>
                    }
                }
            </section>

            <aside class="control-card">
                @if (IsBuilding)
                {
                    <div class="mobile-editor-toolbar">
                        <button class="@(_editorPhase == WebEditorPhase.Structure ? "active-tool" : null) @(_tutorial.Active && _tutorial.Step == TutorialStep.DefensePhase ? "tutorial-target" : null)" @onclick="() => SetEditorPhase(WebEditorPhase.Structure)">@T("editor.phase.structure")</button>
                        <button class="@(_editorPhase == WebEditorPhase.DefensePlacement ? "active-tool" : null) @(_tutorial.Active && _tutorial.Step == TutorialStep.DefensePhase ? "tutorial-target" : null)" @onclick="() => SetEditorPhase(WebEditorPhase.DefensePlacement)">@T("editor.phase.defense")</button>
                        <button class="primary add-button" @onclick="ToggleCatalog">@T("editor.add")</button>
                        <span class="toolbar-spacer"></span>
                        <button @onclick="UndoBuild">@T("common.undo")</button>
                        <button @onclick="RedoBuild">@T("common.redo")</button>
                    </div>
                    @if (_catalogOpen)
                    {
                        <div class="editor-catalog-sheet">
                            <div class="catalog-heading"><strong>@(_editorPhase == WebEditorPhase.Structure ? T("editor.phase.structure") : T("editor.phase.defense"))</strong><button @onclick="ToggleCatalog">×</button></div>
                            <div class="catalog-grid">
                                @if (_editorPhase == WebEditorPhase.Structure)
                                {
                                    <button class="build-option @(_digMode ? "selected" : null)" @onclick="SelectDigMode"><span>@T("editor.add.passage")</span><small>1 cell</small></button>
                                    @foreach (var option in _build!.BuildOptions.Where(x => x.Kind == BuildKind.Room))
                                    {
                                        <button class="build-option @BuildOptionClass(option)" @onclick="() => SelectBuildOption(option)"><span>@BuildOptionText(option.Id)</span><small>@option.CapacityCost</small></button>
                                    }
                                }
                                else
                                {
                                    @foreach (var option in _build!.BuildOptions.Where(x => x.Kind is BuildKind.Trap or BuildKind.Guard or BuildKind.Facility))
                                    {
                                        <button class="build-option @BuildOptionClass(option)" @onclick="() => SelectBuildOption(option)"><span>@BuildOptionText(option.Id)</span><small>@BuildKindText(option.Kind) · @option.CapacityCost</small></button>
                                    }
                                }
                            </div>
                            <div class="catalog-secondary">
                                @if (SelectedBuildOption?.Kind == BuildKind.Room) { <button @onclick="ToggleRotation">@T("rotate_room")</button> }
                                <button class="@(_removeMode ? "danger active-tool" : null)" @onclick="ToggleRemoveMode">@T("remove")</button>
                                <button @onclick="ResetBuild">@T("reset_board")</button>
                            </div>
                        </div>
                    }
                }
                else if (DefenseResult is not null)
                {
                    <div class="mobile-result-actions">
                        <button class="primary" @onclick="ReturnToBuild">@T("return_build")</button>
                        <button @onclick="ToggleRun">@T("run_again")</button>
                        <span class="toolbar-spacer"></span>
                        <button @onclick="ReturnToHub">@T("common.home")</button>
                    </div>
                }
                else
                {
                    <div class="mobile-combat-toolbar">
                        <div class="combat-mp"><span>MP</span><strong>@MpText</strong></div>
                        <button @onclick="CastFreeze" disabled="@(!SpellEnabled("spell.freeze"))">@SpellButtonText("spell.freeze", "freeze")</button>
                        <button @onclick="CastPush" disabled="@(!SpellEnabled("spell.push"))">@SpellButtonText("spell.push", "push")</button>
                        <button class="@(_demo?.AutoBattleEnabled == true ? "active-tool" : null)" @onclick="ToggleAutoBattle">@T(_demo?.AutoBattleEnabled == true ? "auto_on" : "auto_off")</button>
                        <span class="toolbar-spacer"></span>
                        <button @onclick="ToggleRun">@RunButtonText</button>
                        <div class="speed-picker" aria-label="再生速度">
                            @foreach (var speed in new[] { 1, 2, 3 })
                            {
                                <button class="@(speed == _speed ? "active" : null)" @onclick="() => _speed = speed">@speed×</button>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_notice)) { <p class="combat-notice">@_notice</p> }
                }
            </aside>
        </main>
        @if (_narrativeContent is not null)
        {
            <TutorialSpiritOverlay Flow="_tutorial" Content="_narrativeContent" Locale="@_locale" OnNext="TutorialNext" OnSkip="SkipTutorial" />
        }

    </div>
    }
}

@code {
    private enum WebEditorPhase { Structure, DefensePlacement }

    private readonly CancellationTokenSource _cts = new();
    private PeriodicTimer? _timer;
    private const string BrowserSaveKey = "dungeon-defense.web.run.v1";
    private DefenseContent? _content;
    private CosmeticCatalog? _cosmetics;
    private NarrativePresentationContent? _narrativeContent;
    private readonly TutorialFlow _tutorial = new();
    private DungeonBuildDemo? _build;
    private DefenseDemo? _demo;
    private bool _running;
    private int _speed = 1;
    private string? _selectedDefinitionId;
    private bool _removeMode;
    private bool _rotated;
    private string? _notice;
    private bool _showInvasion;
    private bool _showShop;
    private bool _shopOpenedFromTitle;
    private string? _selectedShopProductId;
    private bool _hasSavedRun;
    private string? _titleNotice;
    private bool _showHub;
    private bool _showBriefing;
    private bool _runStarted;
    private bool _catalogOpen;
    private bool _digMode;
    private bool _resultTutorialSignaled;
    private bool _tutorialStartedForRun;
    private WebEditorPhase _editorPhase = WebEditorPhase.Structure;
    private string _locale = WebDemoLocalization.Japanese;

    private bool IsBuilding => _demo is null;
    private DefenseHudVisualState? DefenseHud => _demo?.HudState;
    private DefenseResultVisualState? DefenseResult => _demo?.ResultState;
    private DungeonState Board => _demo?.Board ?? _build!.Board;
    private DungeonBuildVisualState BuildState => _build!.ProductState;
    private BuildOption? SelectedBuildOption => _build?.BuildOptions.SingleOrDefault(x => x.Id == _selectedDefinitionId);
    private string SelectedBuildLabel => SelectedBuildOption is null ? T("none") : BuildOptionText(SelectedBuildOption.Id);
    private string BuildInteractionHint => _removeMode
        ? T("remove_hint")
        : _digMode
            ? T("editor.add.passage")
            : SelectedBuildOption is not null
                ? F("place_hint_plain", SelectedBuildLabel)
                : T("editor.choose_add");
    private string FirstContactText => BuildState.FirstDefenseContactPathIndex < 0 ? T("none") : $"route {BuildState.FirstDefenseContactPathIndex}";

    protected override async Task OnInitializedAsync()
    {
        var defenseTask = WebDefenseContentLoader.LoadAsync(Http, _cts.Token);
        var narrativeTask = WebNarrativeContentLoader.LoadAsync(Http, _cts.Token);
        var cosmeticTask = WebCosmeticContentLoader.LoadAsync(Http, _cts.Token);
        await Task.WhenAll(defenseTask, narrativeTask, cosmeticTask);
        _content = await defenseTask;
        _narrativeContent = await narrativeTask;
        _cosmetics = await cosmeticTask;
        await RefreshSavedRunAvailabilityAsync();
        _ = RunLoopAsync(_cts.Token);
    }


    private async Task StartNewRun()
    {
        if (_content is null) return;
        _build = new DungeonBuildDemo(_content);
        _demo = null;
        _showInvasion = false;
        _running = false;
        _speed = 1;
        _selectedDefinitionId = DefenseSliceBuildCatalog.SpikeTrap.Id;
        _removeMode = false;
        _rotated = false;
        _notice = null;
        _showHub = true;
        _showBriefing = false;
        _catalogOpen = false;
        _digMode = false;
        _editorPhase = WebEditorPhase.Structure;
        _tutorial.Skip();
        _tutorialStartedForRun = false;
        _runStarted = true;
        _showShop = false;
        await PersistRunAsync();
    }

    private async Task ContinueCurrentRun()
    {
        if (_content is null) return;
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", BrowserSaveKey);
            if (string.IsNullOrWhiteSpace(json))
            {
                _hasSavedRun = false;
                _titleNotice = T("start.continue_unavailable");
                return;
            }
            _build = new DungeonBuildDemo(_content, PlayerDungeonSaveCodec.Parse(json));
            _demo = null;
            _runStarted = true;
            _showHub = true;
            _showBriefing = false;
            _showInvasion = false;
            _showShop = false;
            _running = false;
            _notice = null;
            _titleNotice = null;
        }
        catch (Exception)
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", BrowserSaveKey);
            _build = null;
            _hasSavedRun = false;
            _titleNotice = T("start.save_invalid");
        }
    }

    private async Task ReturnToTitle()
    {
        if (_build is not null) await PersistRunAsync();
        // Returning to Title is navigation, not data loss.
        _running = false;
        _showInvasion = false;
        _showBriefing = false;
        _showHub = false;
        _notice = null;
        _showShop = false;
        _runStarted = false;
    }

    private async Task RefreshSavedRunAvailabilityAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", BrowserSaveKey);
            if (string.IsNullOrWhiteSpace(json))
            {
                _hasSavedRun = false;
                return;
            }
            _ = PlayerDungeonSaveCodec.Parse(json);
            _hasSavedRun = true;
        }
        catch (Exception)
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", BrowserSaveKey);
            _hasSavedRun = false;
            _titleNotice = T("start.save_invalid");
        }
    }

    private async Task PersistRunAsync()
    {
        if (_build is null) return;
        var json = PlayerDungeonSaveCodec.Serialize(_build.ExportSave());
        await JS.InvokeVoidAsync("localStorage.setItem", BrowserSaveKey, json);
        _hasSavedRun = true;
        _titleNotice = null;
    }

    private ShopCategoryVisualState CurrentShopState
    {
        get
        {
            if (_cosmetics is null) return new ShopCategoryVisualState(CosmeticCategory.DungeonTheme, []);
            var profile = DungeonBoardProfiles.DefenseSlice;
            var dungeon = _build?.Session.Dungeon
                ?? PlayerDungeonState.FromSingleFloor(profile.CreateBase(), profile.Id);
            var state = new CampaignState(1, "region.first_frontier", dungeon, ResourceBundle.Zero);
            CampaignCosmeticService.GrantDefaults(state, _cosmetics);
