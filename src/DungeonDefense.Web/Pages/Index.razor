    private string BuildCellClass(GridPoint point)
    {
        var classes = new List<string>(4);
        if (Board.IsIngress(point)) classes.Add("ingress");
        if (IsTutorialFocusCell(point)) classes.Add("tutorial-cell-focus");
        if (!IsBuilding || _build is null) return string.Join(' ', classes);
        if (_removeMode)
        {
            if (HasRemovable(point)) classes.Add("remove-target");
            return string.Join(' ', classes);
        }
        if (_editorPhase == WebEditorPhase.Structure && _digMode)
        {
            classes.Add(_build.PreviewDig(point.X, point.Y).Success ? "build-valid" : "build-invalid");
            return string.Join(' ', classes);
        }
        if (_selectedDefinitionId is null) return string.Join(' ', classes);
        var option = SelectedBuildOption;
        if (option is null) return string.Join(' ', classes);
        var allowed = _editorPhase == WebEditorPhase.Structure
            ? option.Kind == BuildKind.Room
            : option.Kind is BuildKind.Trap or BuildKind.Guard or BuildKind.Facility;
        if (!allowed) return string.Join(' ', classes);
        classes.Add(_build.PreviewPlacement(_selectedDefinitionId, point.X, point.Y, _rotated).Success ? "build-valid" : "build-invalid");
        return string.Join(' ', classes);
    }

    private bool IsTutorialFocusCell(GridPoint point)
    {
        if (!_tutorial.Active || _build is null) return false;
        var route = DungeonPathfinder.FindRoute(Board);
        return _tutorial.VisualState.FocusIntent switch
        {
            TutorialFocusIntent.Entrance => Board.IsIngress(point),
            TutorialFocusIntent.CurrentRoute => route.Contains(point),
            TutorialFocusIntent.PassagePlacementAnchor => FindFirstValidDigCell() is { } dig && dig == point,
            TutorialFocusIntent.RoomPlacementFootprint => FindFirstValidPlacement(DefenseSliceBuildCatalog.GuardRoom.Id) is { } room && RoomFootprint(room).Contains(point),
            TutorialFocusIntent.TrapRouteCell => FindFirstValidPlacement(DefenseSliceBuildCatalog.SpikeTrap.Id) is { } trap && trap == point,
            TutorialFocusIntent.GuardInterceptCell => FindFirstValidPlacement(DefenseSliceBuildCatalog.SkeletonWarrior.Id) is { } guard && guard == point,
            TutorialFocusIntent.LatestGuard => Board.Guards.LastOrDefault()?.Position == point,
            _ => false,
        };
    }

    private GridPoint? FindFirstValidDigCell()
    {
        if (_build is null) return null;
        for (var y = 0; y < Board.Height; y++)
        for (var x = 0; x < Board.Width; x++)
        {
            var dig = _build.PreviewDig(x, y);
            if (!dig.Success) continue;
            for (var roomY = 0; roomY < dig.State.Height; roomY++)
            for (var roomX = 0; roomX < dig.State.Width; roomX++)
            {
                var room = DefenseEditCommandService.Evaluate(
                    dig.State,
                    new PlaceRoomCommand("WEB-TUTORIAL-PREVIEW", DefenseSliceBuildCatalog.GuardRoom.Id, roomX, roomY));
                if (room.Success) return new GridPoint(x, y);
            }
        }
        return null;
    }

    private GridPoint? FindFirstValidPlacement(string definitionId)
    {
        if (_build is null) return null;
        for (var y = 0; y < Board.Height; y++)
            for (var x = 0; x < Board.Width; x++)
                if (_build.PreviewPlacement(definitionId, x, y).Success) return new GridPoint(x, y);
        return null;
    }

    private IReadOnlyList<GridPoint> RoomFootprint(GridPoint origin)
    {
        var room = DefenseSliceBuildCatalog.GuardRoom;
        var width = _rotated ? room.Height : room.Width;
        var height = _rotated ? room.Width : room.Height;
        return Enumerable.Range(0, height).SelectMany(y => Enumerable.Range(0, width).Select(x => new GridPoint(origin.X + x, origin.Y + y))).ToArray();
    }

    private bool HasRemovable(GridPoint point)
        => Board.Guards.Any(x => x.Position == point)
           || Board.Traps.Any(x => x.Position == point)
