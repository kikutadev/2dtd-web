    private async Task HandleCellClick(GridPoint point)
    {
        if (_build is null || !IsBuilding) return;

        if (_tutorial.Active && _tutorial.Step == TutorialStep.GuardZone)
        {
            var selectedGuard = Board.Guards.FirstOrDefault(x => x.Position == point);
            if (selectedGuard is not null)
            {
                _tutorial.Accept(TutorialSignal.GuardSelected);
                _notice = T("tutorial.guard_zone_seen");
                return;
            }
        }

        if (_removeMode)
        {
            await RemoveAt(point);
            return;
        }

        if (_editorPhase == WebEditorPhase.Structure && _digMode)
        {
            var result = _build.Dig(point.X, point.Y);
            _notice = result.Success ? T("dug_passage") : result.Error;
            if (result.Success) await PersistRunAsync();
            if (result.Success && _tutorial.Active && _tutorial.Step == TutorialStep.Passage)
                _tutorial.Accept(TutorialSignal.PassageCommitted);
            return;
        }

        if (_selectedDefinitionId is null) return;
        var option = SelectedBuildOption;
        if (option is null) return;
        var resultPlacement = _build.Place(_selectedDefinitionId, point.X, point.Y, _rotated);
        _notice = resultPlacement.Success ? F("placed", SelectedBuildLabel) : resultPlacement.Error;
        if (resultPlacement.Success) await PersistRunAsync();
        if (!resultPlacement.Success || !_tutorial.Active) return;

        if (option.Kind == BuildKind.Room && _tutorial.Step == TutorialStep.Room)
        {
            _tutorial.Accept(TutorialSignal.RoomPlaced);
            _selectedDefinitionId = null;
        }
        else if (option.Kind == BuildKind.Trap && _tutorial.Step == TutorialStep.Trap)
        {
            _tutorial.Accept(TutorialSignal.TrapPlaced);
            _selectedDefinitionId = null;
        }
        else if (option.Kind == BuildKind.Guard && _tutorial.Step == TutorialStep.Guard)
        {
            _tutorial.Accept(TutorialSignal.GuardPlaced);
            _selectedDefinitionId = null;
        }
    }

    private async Task RemoveAt(GridPoint point)
    {
        if (_build is null) return;
        SemanticEditResult? result = null;
        string? label = null;
        var guard = Board.Guards.FirstOrDefault(x => x.Position == point);
        if (guard is not null) { result = _build.Remove(BuildKind.Guard, guard.InstanceId); label = "Guard"; }
        else
        {
            var trap = Board.Traps.FirstOrDefault(x => x.Position == point);
            if (trap is not null) { result = _build.Remove(BuildKind.Trap, trap.InstanceId); label = "Trap"; }
            else
            {
                var facility = Board.Facilities.FirstOrDefault(x => x.Position == point);
                if (facility is not null) { result = _build.Remove(BuildKind.Facility, facility.InstanceId); label = "Facility"; }
                else
                {
                    var room = Board.RoomAt(point);
                    if (room is not null) { result = _build.Remove(BuildKind.Room, room.InstanceId); label = "Room"; }
                }
            }
        }
        if (result is null || label is null)
        {
            _notice = T("nothing_remove");
            return;
        }
        SetRemoveNotice(result, label);
        if (result.Success) await PersistRunAsync();
    }

    private void SetRemoveNotice(SemanticEditResult result, string label)
        => _notice = result.Success ? F("removed", label) : result.Error;

